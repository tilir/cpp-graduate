# Keep the standalone Makefiles usable; the umbrella build uses isolated targets.
if(BUILD_TESTING)
  find_package(Python3 REQUIRED COMPONENTS Interpreter)
endif()
foreach(proj lru-in-c lru-in-c-datastructs lru-in-c-naive)
  set(dir "${PROJECT_SOURCE_DIR}/01-basics/${proj}")
  if(proj STREQUAL "lru-in-c-naive")
    add_executable(${proj} "${dir}/main.c")
  else()
    if(proj STREQUAL "lru-in-c")
      set(map hash_map)
    else()
      set(map int_map)
    endif()
    add_library(${proj}-components STATIC
      "${dir}/src/list.c" "${dir}/src/${map}.c" "${dir}/src/lru.c")
    target_include_directories(${proj}-components PUBLIC "${dir}/include")
    add_executable(${proj} "${dir}/src/main.c")
    target_link_libraries(${proj} PRIVATE ${proj}-components)
    if(BUILD_TESTING)
      add_executable(${proj}-tests "${dir}/tests/test_components.c")
      target_link_libraries(${proj}-tests PRIVATE ${proj}-components)
      # These tests use assert for both checks and calls under test.
      if(MSVC)
        target_compile_options(${proj}-tests PRIVATE /UNDEBUG)
      else()
        target_compile_options(${proj}-tests PRIVATE -UNDEBUG)
      endif()
      add_test(NAME ${proj}-components COMMAND ${proj}-tests)
    endif()
  endif()
  if(BUILD_TESTING)
    add_test(NAME ${proj}
      COMMAND "${Python3_EXECUTABLE}" "${dir}/tests/test_lru.py" "$<TARGET_FILE:${proj}>")
  endif()
endforeach()
